{
  "app": {
    "name": "JAYS",
    "version": "1.0.0",
    "environment": "production",
    "debug": true
  },
  "api": {
    "baseUrl": "https://api.jaysltd.mtgapps.in/api",
    "imageUrl": "https://api.jaysltd.mtgapps.in/",
    "timeout": 10000,
    "retryAttempts": 3,
    "defaultImage": "/core/assets/images/bg/1-general-books.png"
  },
  "TaxSettings" : {
    "StandardTax" : 10
  },
  "company": {
    "name": "JAYS Limited",
    "tagline": "Quality stationery with a customer-first approach",
    "branding": {
      "logo": {
        "url": "assets/images/logo/logo-png5.png",
        "alt": "JAYS Limited Logo"
      },
      "favicon": "assets/images/logo/favicon.ico",
      "themeColor": "#0d6efd"
    },
    "address": {
      "line": "42 Kennedy Avenue",
      "city": "Roseau",
      "country": "Dominica",
      "postalCode": "",
      "full": "42 Kennedy Avenue, Roseau, Dominica"
    },
    "contact": {
      "primaryPhone": "+17674484024",
      "displayPhone": "+1 (767) 448-4025",
      "email": "manager@jaysltd.net"
    },
    "support": {
      "email": "support@jaysltd.net",
      "phone": "tel:+17674484024",
      "displayPhone": "+1 (767) 448-4025",
      "workingHours": "Mon-Fri 9:00 AM - 5:00 PM",
      "mapLink" : "https://www.facebook.com/JaysLimited"
    },
    "socialMedia": [
      {
        "key": "facebook",
        "url": "https://www.facebook.com/JaysLimited",
        "icon": "ph-fill ph-facebook-logo",
        "toolTip": "Facebook",
        "enabled": true
      },
      {
        "key": "instagram",
        "url": "https://www.instagram.com/JaysLimited",
        "icon": "ph-fill ph-instagram-logo",
        "toolTip": "Instagram",
        "enabled": true
      }
    ]
  },
  "insights": {
    "recommendation_Percentage": 20,
    "bestSeller_MinSold": 100,
    "hotDeal_DiscountPercentage": 20,
    "newArrival_MaxSold": 10
  },
  "currency": {
    "base": "XCD",
    "default": "INR",
    "defaultCountry": "IN",
    "autoDetect": true,
    "apis": {
      "exchange": "https://open.er-api.com/v6/latest/",
      "geo": "https://ipapi.co/json/"
    },
    "countryMap": {
      "DM": "XCD",
      "IN": "INR",
      "US": "USD",
      "GB": "GBP",
      "FR": "EUR",
      "DE": "EUR"
    },
    "format": {
      "showSymbol": true,
      "decimalPlaces": 2
    }
  },
  "features": {
    "enableCurrencyAutoDetect": true,
    "enableSocialMedia": true,
    "enableLogging": true,
    "enableDebugTools": true
  },
  "logging": {
    "level": "info",
    "enableRemoteLogging": false
  },
  "security": {
    "enableCSP": true,
    "allowedDomains": [
      "https://api.jaysltd.mtgapps.in/"
    ]
  },
  "location" : {
    "pincodeApi" : "https://api.postalpincode.in/pincode",
    "liveLocationApi" : "https://nominatim.openstreetmap.org/reverse"
  },
  "cache": {
    "enabled": true,
    "ttl": 300000
  }
}
